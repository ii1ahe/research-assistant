# Copy this to .env and fill in real values. DO NOT commit .env.
#
# Every variable here is read by `researcher.config.Settings`. A variable left
# blank counts as "not set", which is the intended state for optional entries.
#
# Keep comments on their own line. The `.env` parser only strips a trailing
# comment when the value before it is non-empty, so a line such as
# `TAVILY_API_KEY=     # get one at tavily.com` sets the key to the comment
# text. That value is a non-empty string, so the application would treat it as
# a real credential and send it to the provider.

# --- LLM (used for synthesis) ---------------------------------------------
# One of: anthropic | openai | gemini (google is accepted as an alias)
LLM_PROVIDER=anthropic

# Shared by every provider, so it must be changed whenever LLM_PROVIDER is.
# The application refuses to start if the two disagree.
LLM_MODEL=claude-sonnet-4-6

# Credential for the provider selected above.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional single credential accepted as a fallback by every provider.
# LLM_API_KEY=

# If you select gemini, two traps are worth knowing about, both verified
# against the live API:
#
#   1. The supplied ai/providers/google.py falls back to `gemini-2.0-flash`
#      when LLM_MODEL is unset, and that model has since been RETIRED — the API
#      answers 404 NOT_FOUND. `gemini-2.5-flash` is refused too ("no longer
#      available to new users"), so no 2.x model is a safe target. Leaving
#      LLM_MODEL blank is therefore not enough for gemini; set it explicitly:
#          LLM_MODEL=gemini-3.8-flash
#      (researcher/config.py applies a working gemini default of its own, but a
#      value here overrides it.)
#
#   2. Reasoning tokens count against the output budget on these models, so a
#      small `max_tokens` yields an EMPTY or truncated response rather than an
#      error. Measured: max_tokens=64 returned "" for gemini-3.7-flash and a
#      truncated "{"answer":" for gemini-3.8-flash; max_tokens=1024 returned
#      valid JSON from both. ai/synthesize calls the provider with no explicit
#      max_tokens and so gets the 1024 default, which is fine — but any caller
#      that passes max_tokens must not pass a small value.

# --- Web search provider ---------------------------------------------------
# One of: tavily | serper | duckduckgo (ddg is accepted as an alias)
WEB_SEARCH_PROVIDER=tavily

# Required when WEB_SEARCH_PROVIDER=tavily. Get one at https://tavily.com
TAVILY_API_KEY=
# Required when WEB_SEARCH_PROVIDER=serper. Get one at https://serper.dev
# SERPER_API_KEY=
# duckduckgo needs no credential, but it does need the optional
# `duckduckgo-search` package to be installed.

# --- Application -----------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# How long a cached retrieval result stays fresh, in seconds.
CACHE_TTL_SECONDS=86400

# Deadline applied to each source independently during retrieval.
PER_SOURCE_TIMEOUT_SECONDS=10

# Deadline for one synthesis, retries included. Kept separate from the value
# above because the two bound different things: a search request that has not
# answered in ten seconds is not going to, while an LLM completion legitimately
# takes tens of seconds. Sharing one number meant a tight fetch budget silently
# killed synthesis — see the benchmark section of README.md.
SYNTHESIS_TIMEOUT_SECONDS=30

# Maximum results requested from each source.
MAX_RESULTS_PER_SOURCE=3

# Upper bound on how many source tasks run at once.
MAX_PARALLEL_SOURCES=3

# Longest accepted question, in characters.
MAX_QUESTION_LENGTH=500

# Which Wikipedia search to use. One of: fulltext | opensearch
#
# `fulltext` sends the question to the MediaWiki search API and is the default.
# `opensearch` uses the supplied `ai.sources.fetch_wikipedia`, which prefix-
# matches the whole query against article *titles* — so a natural-language
# question returns nothing ("photosynthesis" finds three articles, "What is
# photosynthesis and what are its main stages?" finds none). It is kept
# selectable, but `fulltext` is what makes Wikipedia useful here.
WIKIPEDIA_SEARCH=fulltext

# --- Persistence -----------------------------------------------------------
# PostgreSQL DSN, used for both the source cache and the session store (ADR-002).
# When this is blank, nothing is cached and sessions are not stored. The run
# still completes and reports persistence as "skipped" rather than as a failure.
# This cluster runs with PostgreSQL's `initdb` default of `trust`
# authentication, so no password belongs in the DSN:
# DATABASE_URL=postgresql://researcher@localhost:5432/researcher
# Once pg_hba.conf is switched to scram-sha-256 (see docs/security.md), the
# password goes in: postgresql://researcher:PASSWORD@localhost:5432/researcher

# Set to false to run without touching the database even when DATABASE_URL is set.
PERSIST_SESSIONS=true
